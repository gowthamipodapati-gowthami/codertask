<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/includes/header.jspf" %>
<div class="page-hero compact"><div class="eyebrow">ADMIN · CONTENT CREATOR</div><h1>Create a programming mission</h1><p>Question data is saved to MySQL and appears in student missions automatically.</p></div>
<div class="card form-card"><form class="stack-form" method="post" action="<%= base %>/admin/add-question"><input type="hidden" name="csrf" value="<%= CsrfUtil.token(request) %>"><div class="form-columns"><div><label for="title">Mission title *</label><input id="title" name="title" required maxlength="160" placeholder="e.g. Java output prediction"></div><div><label for="category">Category *</label><select id="category" name="category" required><option value="">Choose category</option><option>Java</option><option>SQL</option><option>DSA</option></select></div></div><label for="description">Question description *</label><textarea id="description" name="description" required maxlength="1000" rows="5" placeholder="Write a complete question, including relevant code if needed."></textarea><div class="form-columns"><div><label for="difficulty">Difficulty *</label><select id="difficulty" name="difficulty" required><option value="">Choose difficulty</option><option>Easy</option><option>Medium</option><option>Hard</option></select></div><div><label for="xpReward">XP reward (1–500) *</label><input type="number" id="xpReward" name="xpReward" min="1" max="500" value="25" required></div></div><h3>Answer options</h3><div class="form-columns"><div><label for="optionA">A *</label><input id="optionA" name="optionA" required maxlength="500" placeholder="First answer"></div><div><label for="optionB">B *</label><input id="optionB" name="optionB" required maxlength="500" placeholder="Second answer"></div><div><label for="optionC">C *</label><input id="optionC" name="optionC" required maxlength="500" placeholder="Third answer"></div><div><label for="optionD">D *</label><input id="optionD" name="optionD" required maxlength="500" placeholder="Fourth answer"></div></div><label for="correctAnswer">Correct answer *</label><select id="correctAnswer" name="correctAnswer" required><option value="">Choose the correct option</option><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select><div class="button-group"><button type="submit" class="btn btn-primary">Save mission →</button><a class="btn btn-outline" href="<%= base %>/admin/questions">View all questions</a></div></form></div>
<%@ include file="/WEB-INF/includes/footer.jspf" %>
