<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<% if("1".equals(request.getParameter("loginRequired"))) request.setAttribute("error","Admin authentication is required to access this area."); %>
<%@ include file="/WEB-INF/includes/header.jspf" %>
<section class="auth-layout"><div class="auth-intro"><div class="eyebrow">CONTROL CENTER</div><h1>Administrator access.</h1><p>Manage the challenges students solve. Create questions for Java, SQL, and DSA.</p><div class="mini-info"><%= HtmlUtil.escape(request.getAttribute("adminMessage")) %></div></div><div class="card auth-card"><h2>Admin login</h2><p class="muted">Only authorized administrators may continue.</p><form action="<%= base %>/admin/login" method="post" class="stack-form"><input type="hidden" name="csrf" value="<%= CsrfUtil.token(request) %>"><label for="username">Admin username</label><input id="username" name="username" required autocomplete="username" placeholder="Administrator username"><label for="password">Password</label><input id="password" type="password" name="password" required autocomplete="current-password" placeholder="Administrator password"><button class="btn btn-primary btn-full" type="submit">Open admin dashboard →</button></form><p class="form-caption"><a href="<%= base %>/login">Student login instead</a></p></div></section>
<%@ include file="/WEB-INF/includes/footer.jspf" %>
