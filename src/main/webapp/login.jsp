<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<% if("1".equals(request.getParameter("registered"))) request.setAttribute("success","Registration successful! You can log in now.");
   if("1".equals(request.getParameter("loginRequired"))) request.setAttribute("error","Please log in to access the programming missions."); %>
<%@ include file="/WEB-INF/includes/header.jspf" %>
<section class="auth-layout"><div class="auth-intro"><div class="eyebrow">WELCOME BACK</div><h1>Ready for your next mission?</h1><p>Your questions, XP, levels, and leaderboard rank are waiting.</p><div class="mini-info">Progress is stored securely in MySQL and stays with your account.</div></div><div class="card auth-card"><h2>Student login</h2><p class="muted">Use your username or email to continue.</p><form action="<%= base %>/login" method="post" class="stack-form"><input type="hidden" name="csrf" value="<%= CsrfUtil.token(request) %>"><label for="identity">Username or email</label><input id="identity" name="identity" required maxlength="190" autocomplete="username" value="<%= HtmlUtil.escape(request.getAttribute("oldIdentity")) %>" placeholder="Your username or email"><label for="password">Password</label><input type="password" id="password" name="password" required autocomplete="current-password" placeholder="Your password"><button class="btn btn-primary btn-full" type="submit">Log in →</button></form><p class="form-caption">New student? <a href="<%= base %>/register">Create an account</a></p><p class="form-caption"><a href="<%= base %>/admin/login">Administrator login</a></p></div></section>
<%@ include file="/WEB-INF/includes/footer.jspf" %>
